# Django Settings
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database Settings
# For Docker, use /app/data/db.sqlite3
DB_PATH=/app/data/db.sqlite3

# Docker Settings
WEB_PORT=8004

# --- Docker Settings ---
# Startbefehl für den Docker-Container
# Für lokale Entwicklung: Einfach auskommentiert lassen (nutzt dann den Django 'runserver')
# Für das Live-System / Produktion (NAS): Unbedingt die Gunicorn-Zeile einkommentieren!
#START_COMMAND="gunicorn marina_project.wsgi:application --bind 0.0.0.0:8000 --workers 3 --threads 2"
CONTAINER_NAME=marina_web
IMAGE_NAME=marina_image
DB_DIR=./data

# Multi-Tenant Domain Mappings
TENANT_ORMOS_DOMAIN=marina.your-domain.com
TENANT_KARLOVASI_DOMAIN=shipyard.your-domain.com

# myDATA (Greece) API Settings - Global Fallback
MYDATA_USER=your_user_id
MYDATA_SUBSCRIPTION_KEY=your_key
MYDATA_ENVIRONMENT=sandbox
MYDATA_VAT_NUMBER=888888888

# myDATA Settings - Tenant: ormos
TENANT_ORMOS_MYDATA_USER=your_user_id
TENANT_ORMOS_MYDATA_SUBSCRIPTION_KEY=your_key
TENANT_ORMOS_MYDATA_ENVIRONMENT=sandbox
TENANT_ORMOS_MYDATA_VAT_NUMBER=888888888

# myDATA Settings - Tenant: karlovasi
TENANT_KARLOVASI_MYDATA_USER=your_user_id
TENANT_KARLOVASI_MYDATA_SUBSCRIPTION_KEY=your_key
TENANT_KARLOVASI_MYDATA_ENVIRONMENT=sandbox
TENANT_KARLOVASI_MYDATA_VAT_NUMBER=888888888


