# Marina Samos - Konfiguration
# Diese Datei als ".env" speichern (nicht ".env.example")
# Pfade mit Backslash verdoppeln unter Windows: C:\\Users\\...

# ── Datenbank ────────────────────────────────────────
# Standard: SQLite lokal im Programmordner (kein Eintrag nötig)
DB_ENGINE=django.db.backends.sqlite3

# SQLite - alternativer Pfad (z.B. OneDrive für Mehrbenutzer)
# DB_PATH=C:\\Users\\Benutzername\\OneDrive\\Marina\\db.sqlite3

# MariaDB/MySQL (nur wenn Datenbankserver vorhanden)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=marina
# DB_USER=marina_user
# DB_PASSWORD=geheim
# DB_HOST=localhost
# DB_PORT=3306

# ── Server ───────────────────────────────────────────
# Für lokalen Betrieb nicht ändern nötig
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Für Produktivbetrieb auf eigenem Server:
# DEBUG=False
# ALLOWED_HOSTS=marina.meinedomain.de,www.marina.meinedomain.de
# SECRET_KEY=hier-einen-langen-zufaelligen-string-einsetzen
